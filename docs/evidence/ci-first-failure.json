  "failure_root_cause": {
    "step_name": "Check machine headers and package notices with SHA integrity",
    "script": "scripts/ci/package_artifact.py",
    "error_type": "ValueError",
    "error_message": "ZIP does not support timestamps before 1980",
    "trigger": "bundle.write(path, arcname=name) in ZipFile context manager",
    "details": "scripts/ci/package_artifact.py collects notice files from crates in the cargo registry (~/.cargo/registry/src/...). Many crates.io packages have license files with synthetic timestamps (e.g. mtime=1.0 or 123456789.0). Python zipfile.ZipInfo.from_file() inspects file mtime and raises ValueError(\"ZIP does not support timestamps before 1980\") when mtime is prior to 1980-01-01. As a result, all 5 native build matrix jobs crashed during artifact zip packaging before reaching the upload step."
  },
