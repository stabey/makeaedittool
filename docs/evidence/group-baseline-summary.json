  "scenario_definitions": {
    "service_lazy_session": "Headless CLI SQLite recovery worker session benchmark (editor-services session-bench); measures metadata scan & single active draft hydrate without GUI window or AppKit runloop.",
    "native_startup_recovery": "Native GPUI Kit desktop GUI process (editor --smoke=startup); initializes GPUI/Metal window, attaches SQLite recovery worker, reconstructs SessionManifest with N tabs, hydrates exactly 1 active tab (leaving N-1 tabs lazy stubs), pumps draw frame, requests clean shutdown, waits for durable ACK, emits report, quits.",
    "native_usability": "Native GPUI Kit GUI usability verification (editor --smoke=usability); exercises palette, switcher, metadata-only preferences, CRLF line operations, BOM format changes, MRU persistence.",
    "native_full": "Native GPUI Kit GUI full functional verification (editor --smoke=full); exercises programmatic editing, undo/redo, search, CRLF/BOM roundtrip, paged view, and clean shutdown."
  },
